# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=business_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_platform?schema=public

# JWT (use long random values outside development)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Payments — MANUAL | ASAAS | MERCADO_PAGO | STRIPE (only MANUAL is implemented)
PAYMENT_DEFAULT_PROVIDER=MANUAL

# Notifications — logs messages of channels without a configured provider (sensitive content is redacted)
NOTIFICATION_DEV_LOG=true

# HTTP — set when running behind a reverse proxy/load balancer so rate limiting sees the client IP
# (hop count such as 1, true, or a list of trusted addresses). Leave empty when exposed directly.
TRUST_PROXY=

# Password recovery
# Frontend page that receives ?token=... and calls POST /auth/reset-password.
# Required for reset e-mails to be sent; must be a trusted URL controlled by you.
PASSWORD_RESET_URL=http://localhost:3001/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Silent minimum interval between two reset e-mails for the same account
PASSWORD_RESET_COOLDOWN_SECONDS=60
# Requests per client IP, per endpoint (forgot/reset/change password), within the window
PASSWORD_RATE_LIMIT_MAX=5
PASSWORD_RATE_LIMIT_TTL_SECONDS=900

# E-mail (SMTP). Delivery stays disabled until SMTP_HOST and EMAIL_FROM are set.
# Works with any SMTP provider (Amazon SES, SendGrid, Mailgun, Resend, ...).
# Local testing: `docker compose --profile mail up -d mailpit`, SMTP_HOST=localhost, SMTP_PORT=1025.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); false uses STARTTLS when offered (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
