# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=business_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_platform?schema=public

# JWT (use long random values outside development)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Payments — MANUAL | ASAAS | MERCADO_PAGO | STRIPE (only MANUAL is implemented)
PAYMENT_DEFAULT_PROVIDER=MANUAL

# Notifications — logs messages while Email/WhatsApp/Push providers are not integrated
NOTIFICATION_DEV_LOG=true
