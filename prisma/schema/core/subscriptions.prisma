enum BillingInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY

  @@map("billing_interval")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

/// Generic recurring plan. Segment-specific benefits live in business modules.
model SubscriptionPlan {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  name            String
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  currency        String          @default("BRL") @db.Char(3)
  billingInterval BillingInterval @map("billing_interval")
  durationDays    Int             @map("duration_days")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  benefits      BarbershopPlanBenefit[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  planId             String             @map("plan_id")
  customerId         String             @map("customer_id")
  status             SubscriptionStatus @default(ACTIVE)
  price              Decimal            @db.Decimal(10, 2)
  startDate          DateTime           @map("start_date")
  endDate            DateTime           @map("end_date")
  autoRenew          Boolean            @default(false) @map("auto_renew")
  nextRenewalAt      DateTime?          @map("next_renewal_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancellationReason String?            @map("cancellation_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([tenantId, status, endDate])
  @@index([customerId, status])
  @@index([planId])
  @@map("subscriptions")
}
