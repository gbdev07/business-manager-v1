enum BusinessType {
  BARBERSHOP
  SALON
  RETAIL
  SERVICES
  OTHER

  @@map("business_type")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("tenant_status")
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  businessType BusinessType @map("business_type")
  status       TenantStatus @default(ACTIVE)
  document     String?
  email        String?
  phone        String?
  timezone     String       @default("America/Sao_Paulo")
  currency     String       @default("BRL") @db.Char(3)
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Back-relations required by Prisma. Business modules reference Tenant, never the opposite in code.
  users                 User[]
  customers             Customer[]
  services              Service[]
  products              Product[]
  sales                 Sale[]
  payments              Payment[]
  subscriptionPlans     SubscriptionPlan[]
  subscriptions         Subscription[]
  auditLogs             AuditLog[]
  barbershopSettings    BarbershopSettings?
  barbers               Barber[]
  appointments          Appointment[]
  barbershopPlanBenefit BarbershopPlanBenefit[]
  commissionRules       CommissionRule[]
  commissions           Commission[]
  memberships           TenantMembership[]
  refreshTokens         RefreshToken[]

  @@index([status])
  @@index([businessType])
  @@map("tenants")
}

/// System roles (OWNER, ADMIN, MANAGER, EMPLOYEE). New roles are rows, not code changes.
model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  memberships TenantMembership[]

  @@map("roles")
}

model User {
  id                String    @id @default(uuid())
  /// Home tenant: where this user is administered. The active tenant of a session is the refresh token, not this column.
  tenantId          String    @map("tenant_id")
  roleId            String    @map("role_id")
  name              String
  email             String    @unique
  passwordHash      String    @map("password_hash")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  /// Embedded in access tokens; incrementing it invalidates every access token already issued.
  sessionVersion    Int       @default(0) @map("session_version")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  memberships         TenantMembership[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  sales               Sale[]
  auditLogs           AuditLog[]
  barber              Barber?

  @@index([tenantId, isActive])
  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  /// Tenant this session is operating in. Other sessions of the same user keep their own value.
  tenantId  String    @map("tenant_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// One identity's access to one tenant. This is the authorization record for listing and switching;
/// it does not replace `User.tenantId`, which remains the home tenant used by user administration.
model TenantMembership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  roleId    String   @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, isActive])
  @@map("tenant_memberships")
}

/// Single-use password reset token. Only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
