enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED

  @@map("payment_status")
}

enum PaymentGateway {
  MANUAL
  ASAAS
  MERCADO_PAGO
  STRIPE

  @@map("payment_gateway")
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_SLIP
  BANK_TRANSFER
  OTHER

  @@map("payment_method")
}

model Payment {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  customerId     String?        @map("customer_id")
  saleId         String?        @map("sale_id")
  subscriptionId String?        @map("subscription_id")
  /// Generic reference for business modules (e.g. referenceType = "barbershop.appointment").
  referenceType  String?        @map("reference_type")
  referenceId    String?        @map("reference_id")
  amount         Decimal        @db.Decimal(12, 2)
  currency       String         @default("BRL") @db.Char(3)
  status         PaymentStatus  @default(PENDING)
  gateway        PaymentGateway @default(MANUAL)
  method         PaymentMethod?
  externalId     String?        @map("external_id")
  description    String?
  dueDate        DateTime?      @map("due_date")
  paidAt         DateTime?      @map("paid_at")
  cancelledAt    DateTime?      @map("cancelled_at")
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale         Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, paidAt])
  @@index([tenantId, createdAt])
  @@index([customerId])
  @@index([saleId])
  @@index([subscriptionId])
  @@index([referenceType, referenceId])
  @@index([gateway, externalId])
  @@map("payments")
}
