// Multi-file Prisma schema.
//   core/        → entities reusable by any business segment
//   barbershop/  → entities owned by the barbershop business module
// Every tenant-owned table carries `tenant_id` (shared database + shared schema strategy).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
